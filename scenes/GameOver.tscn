[sub_resource type="GDScript" id="GDScript_j3qfp"]
script/source = "extends Control

signal terminado

@onready var texto_label = $RichTextLabel
@onready var timer_letras = $Timer
@onready var voz = $VozSonido

var frases = []
var indice = 0
var tiempo_lectura = 2.5 # Segundos que se queda el texto antes de irse solo

func _ready():
	self.hide()
	timer_letras.wait_time = 0.05
	if not timer_letras.timeout.is_connected(_on_timer_timeout):
		timer_letras.timeout.connect(_on_timer_timeout)

func iniciar_charla(lista):
	frases = lista
	indice = 0
	self.show()
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	escribir_frase()

func escribir_frase():
	if indice < frases.size():
		texto_label.text = frases[indice]
		texto_label.visible_characters = 0
		timer_letras.start()
	else:
		finalizar()

func _on_timer_timeout():
	if texto_label.visible_characters < texto_label.text.length():
		texto_label.visible_characters += 1
		
		# --- LÓGICA DE VOZ ESTILO UNDERTALE ---
		if voz:
			# Obtenemos el carácter actual
			var car = texto_label.text[texto_label.visible_characters - 1]
			# Solo suena si no es un espacio o signo de puntuación común
			if car != \" \" and car != \".\" and car != \",\" and car != \"!\" and car != \"?\":
				# Variamos el tono ligeramente para cada letra
				voz.pitch_scale = randf_range(0.95, 1.25)
				voz.play()
		# --------------------------------------
		
	else:
		timer_letras.stop()
		# --- ESPERA AUTOMÁTICA ---
		# Espera un momento para que el jugador lea y pasa solo
		await get_tree().create_timer(tiempo_lectura).timeout
		
		# Verificamos que sigamos en este mismo diálogo antes de avanzar
		if self.visible:
			indice += 1
			escribir_frase()

# Se eliminó la función _input para que el jugador no pueda saltarlo

func finalizar():
	self.hide()
	Input.set_mouse_mode(Input.MOUSE_MODE_VISIBLE)
	emit_signal(\"terminado\")
"

