[sub_resource type="GDScript" id="GDScript_6p1es"]
script/source = "extends Area3D

@export_category(\"Transición a Batalla 2D\")
@export var escena_batalla_2d: PackedScene
@export var pared_bloqueo: StaticBody3D

var pelea_iniciada: bool = false
var frames_seguridad: int = 0

func _ready():
	body_entered.connect(_on_body_entered)

func _physics_process(delta):
	if frames_seguridad < 10:
		frames_seguridad += 1

func _on_body_entered(body: Node3D):
	if pelea_iniciada or frames_seguridad < 10:
		return

	if body.is_in_group(\"player\"):
		if \"global_position\" in body and body.global_position is Vector3:
			pelea_iniciada = true
			# USAMOS CALL_DEFERRED: Esto evita el error rojo de colisiones
			call_deferred(\"_iniciar_transicion\")

func _iniciar_transicion():
	if not escena_batalla_2d:
		print(\"ERROR: No asignaste la escena Batalla2D.\")
		pelea_iniciada = false
		return

	# 1. Agarramos todo el nivel 3D actual (Mundo2)
	var mundo_3d = get_tree().current_scene

	# 2. Lo pausamos y lo ocultamos (el juego queda \"congelado\" de fondo)
	mundo_3d.process_mode = Node.PROCESS_MODE_DISABLED
	mundo_3d.hide()

	# 3. Creamos la Batalla 2D y la agregamos al \"Root\" para que se vea perfecta con su cámara
	var batalla = escena_batalla_2d.instantiate()
	get_tree().root.add_child(batalla)

	# 4. MAGIA: Esperamos pausados hasta que la escena 2D sea destruida
	await batalla.tree_exited

	# 5. ¡El jefe murió! Volvemos a mostrar y despausar el mundo 3D
	# ¡El jugador estará en el milímetro exacto donde pisó el área!
	mundo_3d.show()
	mundo_3d.process_mode = Node.PROCESS_MODE_INHERIT

	# 6. Borramos la pared de bloqueo si es que tenías una
	if is_instance_valid(pared_bloqueo):
		pared_bloqueo.queue_free()

	# 7. Borramos esta Area3D para no volver a entrar
	queue_free()
"

