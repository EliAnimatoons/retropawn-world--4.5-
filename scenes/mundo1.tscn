[sub_resource type="GDScript" id="GDScript_abp0n"]
script/source = "extends Node3D

var cuadro_negro: ColorRect
var lider_instanciado = false 
var _terminado: bool = false

var escena_lider = null
var escena_minion = null

var bajas_actuales = 0 
@export var bajas_necesarias = 4

@onready var punto_spawn = $PuntoSpawnJefe 

func _ready():
	# INYECCIÓN: Avisamos que este nivel requiere salto y gravedad
	get_viewport().scaling_3d_scale = ProgresoJuego.escala_3d
	# --- CARGA SEGURA DE ESCENAS ---
	var r_lider = \"res://scenes/LiderMinion.tscn\"
	var r_minion = \"res://scenes/minion.tscn\"
	
	if ResourceLoader.exists(r_lider): escena_lider = load(r_lider)
	if ResourceLoader.exists(r_minion): escena_minion = load(r_minion)

	# --- LÓGICA DE INTRO ---
	var ruta_intro = \"res://scenes/IntroNivel.tscn\"
	if ResourceLoader.exists(ruta_intro):
		var intro = load(ruta_intro).instantiate()
		add_child(intro)
		if intro.has_method(\"configurar\"):
			intro.configurar(\"Battered-tropolis\", \"Level1 by Nubbi\")
	
	var player = get_tree().get_first_node_in_group(\"player\")
	if player:
		player.set_physics_process(false)
		await get_tree().create_timer(3.6).timeout
		player.set_physics_process(true)
	
	# --- ARRANCA EL CRONÓMETRO DEL SCORE (después de la intro) ---
	EstadisticasNivel.iniciar_nivel()
	
	cuadro_negro = find_child(\"ColorRect\", true, false)
	if cuadro_negro:
		cuadro_negro.modulate.a = 0.0

	# --- PERSISTENCIA DE OBJETOS ---
	# Usamos un pequeño delay para que la comprobación no falle en el primer frame
	await get_tree().process_frame
	if ProgresoJuego.max_desbloqueado:
		var jaula = find_child(\"*Jaula*\", true, false)
		if jaula: jaula.queue_free()
		var max_npc = find_child(\"*Max_NPC*\", true, false)
		if max_npc: max_npc.queue_free()

func _process(_delta):
	# --- INYECCIÓN DE SEGURIDAD ANTI-BUG (Vigilante de la Realidad) ---
	var p = get_tree().get_first_node_in_group(\"player\")
	if is_instance_valid(p):
		# 1. Detectar infinitos (NaN o Inf) causados por colisiones rotas
		if not is_finite(p.global_position.x) or not is_finite(p.global_position.y) or not is_finite(p.global_position.z):
			print(\"VIGILANTE: Error de realidad detectado. Castigando...\")
			Cargador.ir_a_escena(\"res://scenes/CapaCastigo.tscn\")
			return # Detener ejecución inmediata
		
		# 2. Detectar caída al vacío extremo (Opcional, pero recomendado)
		if p.global_position.y < -30.0:
			Cargador.ir_a_escena(\"res://scenes/CapaCastigo.tscn\")
			return

	if not lider_instanciado and Time.get_ticks_msec() > 10000:
		var enemigos = get_tree().get_nodes_in_group(\"enemies\")
		if enemigos.size() == 0:
			lider_instanciado = true
			invocar_batalla_final()

func registrar_muerte():
	if lider_instanciado: return
	bajas_actuales += 1
	if bajas_actuales >= bajas_necesarias:
		lider_instanciado = true
		invocar_batalla_final()

func invocar_batalla_final():
	print(\"¡SPAWNEANDO AL LÍDER!\")
	
	# --- FIX SONIDO: Aseguramos la extensión .mp3 ---
	var ruta_sonido = \"res://sonidos/boss_spawn.mp3\"
	if ResourceLoader.exists(ruta_sonido):
		var sonido_boss = AudioStreamPlayer.new()
		add_child(sonido_boss)
		sonido_boss.stream = load(ruta_sonido)
		sonido_boss.volume_db = 5.0
		sonido_boss.play()
		sonido_boss.finished.connect(sonido_boss.queue_free)
	
	var spawn_pos = punto_spawn.global_position if punto_spawn else Vector3.ZERO
	
	if escena_lider:
		var lider = escena_lider.instantiate()
		add_child(lider)
		lider.global_position = spawn_pos
		lider.add_to_group(\"boss\") 
		lider.add_to_group(\"enemies\")
	
	if escena_minion:
		for i in range(5):
			var escolta = escena_minion.instantiate()
			add_child(escolta)
			escolta.add_to_group(\"enemies\") 
			var angulo = i * (PI * 2 / 5)
			escolta.global_position = spawn_pos + Vector3(cos(angulo), 0, sin(angulo)) * 3.0

# --- FINAL DEL NIVEL: ahora va al SCORE (el score desbloquea el siguiente nivel) ---
func _on_trigger_final_body_entered(body):
	if _terminado: return
	if body.is_in_group(\"player\"):
		_terminado = true
		EstadisticasNivel.finalizar_nivel(1)          # índice 1 = mundo 1
		ProgresoJuego.finalizar_nivel_exitosamente()  # monedas, rescates y logros (necesita este nivel cargado)
		body.set_physics_process(false)
		
		if cuadro_negro:
			var tween = create_tween()
			tween.tween_property(cuadro_negro, \"modulate:a\", 1.0, 3.0)
			await tween.finished
		
		EstadisticasNivel.ir_al_score()

func _on_zona_instructor_body_entered(_body: Node3D) -> void: pass
func _on_timer_letras_timeout() -> void: pass
"

