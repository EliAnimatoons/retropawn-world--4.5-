; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Retropawn WORLD version funcional"
config/description="THE BEST GAME OF THE YEAR, RetroPawn WORLD!"
config/version="1.0"
run/main_scene="uid://dwq1oeyuofexy"
config/features=PackedStringArray("4.7", "GL Compatibility")
run/max_fps=30
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/stretch_mode=0
boot_splash/image="uid://dw03p1ijxm0vb"
config/icon="uid://ch0uiqbbuprxp"
boot_splash/minimum_display_time=3000

[audio]

buses/default_bus_layout="uid://5ktebt47770o"

[autoload]

GameManager="*res://scripts/GameManager.gd"
EfectosManager="*res://scripts/EfectosManager.gd"
