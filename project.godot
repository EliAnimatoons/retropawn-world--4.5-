GlobalConfig="*uid://d8jca47mdtiw"
PocionManager="*uid://c3p7xvfcfpylp"
ComboUi="*uid://b8n6h76ma2ec6"
NotificadorLogros="*uid://dq78s70w0i4j3"
Utils="*uid://pxymtv51oamj"
DialogueManager="*uid://c3rodes2l3gxb"
